# Caddy 2.10.2; use the same canonical HTTPS origin as the Reader API.
# CHAPTERA_READER_ROOT points to the extracted immutable static release.
# Runtime/BlobStore/scanner/cleanup configuration remains server-owned.
{
    admin off
}

{$CHAPTERA_READER_SITE:cloud.example.invalid} {
    encode gzip
    header {
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        -Server
    }

    # Current Rust edge treats guest content as ordinary API (8 MiB).
    # Set cloud_reader_guest.max_file_bytes <= edge.max_api_body_bytes.
    # This recipe does not claim a 64 MiB guest upload path.
    @reader_api path /v1/reader/*
    request_body @reader_api {
        max_size 8MiB
    }
    handle @reader_api {
        reverse_proxy {$CHAPTERA_READER_API:127.0.0.1:8080} {
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto https
            header_up X-Forwarded-Host {host}
            transport http {
                dial_timeout 2s
                response_header_timeout 120s
            }
        }
    }
    # Other product APIs are outside this public Reader surface.
    handle /v1/* {
        respond "Not found" 404
    }
    handle {
        root * {$CHAPTERA_READER_ROOT:/opt/chaptera/cloud-reader/current}
        header {
            Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src data:; connect-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'none'"
            Cache-Control "no-cache"
        }
        file_server
    }
}
