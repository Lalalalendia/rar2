# Caddy 2.10.2; Cloud Reader and the anonymous Temporary Editor share one Chaptera binary.
# CHAPTERA_READER_API is the private loopback Chaptera listener.
# Runtime/BlobStore/scanner/cleanup configuration remains server-owned.
{
    admin off
}

{$CHAPTERA_READER_SITE:cloud.example.invalid} {
    encode gzip
    header {
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src data:; connect-src 'self'; base-uri 'none'; object-src 'none'; frame-src blob:; frame-ancestors 'none'; form-action 'none'"
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        -Server
    }

    # Anonymous upload and temporary edit use the same bounded public ingress.
    # Never proxy authenticated Product Editor, OIDC or tenant routes here.
    # Set cloud_reader_guest.max_file_bytes <= edge.max_api_body_bytes.
    @reader_api path /v1/reader/* /v1/editor/temporary-sessions /v1/editor/temporary-sessions/*
    request_body @reader_api {
        max_size 8MiB
    }

    # Exact allowlist for Reader plus guest-only Temporary Editor.
    # Static and API paths below must remain explicit; never use /editor/*
    # or /v1/editor/*, which would expose authenticated Product surfaces.
    @reader_surface path / /index.html /favicon.svg /reader.css /reader-app.mjs /reader-model.mjs /render-v1.mjs /observability-v1.mjs /v1/reader/* /editor/temporary-preview /editor/temporary-edit-browser-session-v0.mjs /editor/temporary-editor-preview.mjs /editor/temporary-editor-preview.css /editor/temporary-edit-move-client-v1.mjs /editor/text-protocol-v1.mjs /editor/story-line-endings-v1.mjs /editor/interaction-v1.mjs /editor/reader-scene-editor-interaction-v1.mjs /cloud-reader/render-v1.mjs /v1/editor/temporary-sessions /v1/editor/temporary-sessions/*
    handle @reader_surface {
        reverse_proxy {$CHAPTERA_READER_API:127.0.0.1:8080} {
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto https
            # Keep the external Host and explicit port for Rust's exact Origin/CSRF checks.
            header_up X-Forwarded-Host {hostport}
            transport http {
                dial_timeout 2s
                response_header_timeout 120s
            }
        }
    }

    # Health/operator/auth/tenant/Product authoring surfaces are not part of this public origin.
    handle {
        respond "Not found" 404
    }
}
