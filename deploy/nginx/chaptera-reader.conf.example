# Chaptera public Cloud Reader behind the existing host Nginx.
# The Chaptera process listens only on 127.0.0.1:8080.
# TLS directives are intentionally left to Certbot on the target host.

server {
    listen 80;
    listen [::]:80;
    server_name reader.chaptera.online;

    client_max_body_size 8m;
    server_tokens off;

    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src data:; connect-src 'self'; base-uri 'none'; object-src 'none'; frame-src blob:; frame-ancestors 'none'; form-action 'none'" always;

    location = / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_connect_timeout 2s;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }

    location ~ ^/(?:index\.html|favicon\.svg|reader\.css|reader-app\.mjs|reader-model\.mjs|render-v1\.mjs|observability-v1\.mjs)$ {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_connect_timeout 2s;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }

    location ^~ /v1/reader/ {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_connect_timeout 2s;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }

    # Browser Temporary Editor runs on the same HTTPS host as Reader.
    # This is an exact, case-sensitive source-neutral asset allowlist.
    # Never forward a broad /editor/* or /v1/editor/* Product/OIDC route.
    location ~ ^/(?:editor/(?:temporary-preview|temporary-editor-preview\.(?:mjs|css)|temporary-edit-browser-session-v0\.mjs|temporary-edit-move-client-v1\.mjs|text-protocol-v1\.mjs|story-line-endings-v1\.mjs|interaction-v1\.mjs|reader-scene-editor-interaction-v1\.mjs)|cloud-reader/render-v1\.mjs|packages/protocol/editor-resize/v1/resize-gesture-v1\.mjs)$ {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_connect_timeout 2s;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }

    # Guest-only upload, capability-authenticated Current/Scene/MoveNode/StoryRange,
    # bounded edited exports and explicit DELETE. Restrict path to the
    # canonical tempedit:hex32 identity; arbitrary Product routes remain 404.
    # Quantified {32} requires quoted PCRE for Nginx config lexer.
    location ~ "^/v1/editor/temporary-sessions(?:/tempedit:[0-9a-f]{32}(?:/(?:current|scene|move-node|story-range|resize-node|exports/(?:idml|odg|pdf9up|pdf)))?)?$" {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_connect_timeout 2s;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }

    location / {
        return 404;
    }
}
